new file mode 100644
index 0000000..53048b4
--- /dev/null
+++ b/inventory_app/tests/test_export.py
@@ -0,0 +1,179 @@
+import csv
+import io
+
+import pytest
+
+import app.db as db_module
+from app import repo
+from app.db import get_db, transaction
+from app.services import export, stock
+
+PATHS = ["/export/blank.csv", "/export/printed.csv"]
+
+
+def _admin():
+    return repo.get_user_by_name("admin")
+
+
+def _item_id(brand="Printstar"):
+    return get_db().execute("SELECT id FROM item WHERE brand = ?", (brand,)).fetchone()["id"]
+
+
+def _receive(brand, color, size, qty, variant_name=""):
+    with transaction():
+        v = stock.get_or_create_variant(repo.get_item(_item_id(brand)), color, size, variant_name)
+        stock.receive(_admin(), v, qty)
+        return v
+
+
+def _rows(resp):
+    """レスポンスを、Excelと同じように BOM 付き UTF-8 として読み、行のリストにする。"""
+    return list(csv.reader(io.StringIO(resp.data.decode("utf-8-sig"), newline="")))
+
+
+def test_login_required(client):
+    for path in PATHS:
+        r = client.get(path)
+        assert r.status_code == 302 and "/login" in r.headers["Location"], path
+
+
+def test_staff_can_download(client, login):
+    login("staff")
+    for path in PATHS:
+        assert client.get(path).status_code == 200, path
+
+
+def test_blank_csv_format_for_excel(client, login, app):
+    _receive("Printstar", "黒", "M", 10)
+    login("staff")
+    r = client.get("/export/blank.csv")
+    assert r.status_code == 200
+    assert r.headers["Content-Type"] == "text/csv; charset=utf-8"
+    assert r.headers["Content-Disposition"].startswith('attachment; filename="inventory_blank_')
+    assert r.headers["Content-Disposition"].endswith('.csv"')
+    assert r.headers["Cache-Control"] == "no-store"
+    assert r.data.startswith(b"\xef\xbb\xbf")        # BOM(Excelの文字化け防止)
+    assert b"\r\n" in r.data                          # CRLF
+    rows = _rows(r)
+    assert rows[0] == export.BLANK_HEADERS
+    assert ["Tシャツ", "Printstar", "085-CVT", "Tシャツ", "黒", "M", "", "10", "使用中"] in rows
+
+
+def test_quantity_is_plain_number_and_zero_rows_are_included(client, login, app):
+    _receive("Printstar", "黒", "M", 5)
+    _receive("Printstar", "白", "M", 3)
+    with transaction():
+        stock.ship(_admin(), repo.find_variant(_item_id(), "白", "M", ""), 3)
+    login()
+    resp = client.get("/export/blank.csv")
+    raw = resp.data.decode("utf-8-sig")
+    assert '"5"' not in raw and '"0"' not in raw       # 数量は引用符なしの数値(Excelで数値になる)
+    rows = _rows(resp)
+    assert next(r for r in rows if r[4] == "黒")[7] == "5"
+    assert next(r for r in rows if r[4] == "白")[7] == "0"   # 在庫0の行も出る
+
+
+def test_stopped_item_is_marked(client, login, app):
+    _receive("United Athle", "赤", "L", 2)
+    with transaction() as db:
+        db.execute("UPDATE item SET is_active = 0 WHERE brand = 'United Athle'")
+    login()
+    row = next(r for r in _rows(client.get("/export/blank.csv")) if r[1] == "United Athle")
+    assert row[8] == "停止中"
+
+
+def test_sizes_are_in_natural_order(client, login, app):
+    for size in ["XL", "S", "L", "M"]:
+        _receive("Printstar", "黒", size, 1)
+    login()
+    sizes = [r[5] for r in _rows(client.get("/export/blank.csv")) if r[1] == "Printstar"]
+    assert sizes == ["S", "M", "L", "XL"]
+
+
+def test_category_filter(client, login, app):
+    _receive("Printstar", "黒", "M", 1)
+    _receive("", "", "", 4, variant_name="赤")          # バッジ(カテゴリー2)
+    login()
+    both = _rows(client.get("/export/blank.csv"))
+    assert {r[0] for r in both[1:]} == {"Tシャツ", "バッジ"}
+    only = _rows(client.get("/export/blank.csv?category=2"))
+    assert {r[0] for r in only[1:]} == {"バッジ"}
+    assert _rows(client.get("/export/blank.csv?category=999"))[1:] == []   # 存在しないIDは見出しだけ
+    assert len(_rows(client.get("/export/blank.csv?category=abc"))) == len(both)  # 不正な値は全件
+    assert client.get(f"/export/blank.csv?category={10**30}").status_code == 200  # 巨大な値でも500にならない
+
+
+def test_special_characters_round_trip(client, login, app):
+    with transaction() as db:
+        db.execute("UPDATE item SET name = ? WHERE brand = 'Printstar'", ('A,"B"\nC',))
+    _receive("Printstar", "黒", "M", 1)
+    login()
+    row = next(r for r in _rows(client.get("/export/blank.csv")) if r[1] == "Printstar")
+    assert row[3] == 'A,"B"\nC'
+
+
+@pytest.mark.parametrize("evil", ["=1+1", "+1", "-1", "@SUM(A1)", "\t=1"])
+def test_formula_injection_is_neutralized(client, login, app, evil):
+    with transaction() as db:
+        db.execute("UPDATE item SET name = ? WHERE brand = 'Printstar'", (evil,))
+    _receive("Printstar", "黒", "M", 1)
+    login()
+    row = next(r for r in _rows(client.get("/export/blank.csv")) if r[1] == "Printstar")
+    assert row[3] == "'" + evil
+
+
+def test_safe_cell_leaves_normal_values_alone():
+    assert export.safe_cell("黒") == "黒"
+    assert export.safe_cell("") == ""
+    assert export.safe_cell(0) == 0 and export.safe_cell(12) == 12
+
+
+def test_printed_csv(client, login, app):
+    v = _receive("Printstar", "黒", "M", 10)
+    with transaction():
+        stock.convert_to_printed(_admin(), v, "ねこロゴ", 6, 5)
+    login()
+    rows = _rows(client.get("/export/printed.csv"))
+    assert rows[0] == export.PRINTED_HEADERS
+    assert ["ねこロゴ", "Tシャツ", "Printstar", "085-CVT", "Tシャツ", "黒", "M", "", "5"] in rows
+
+
+def test_empty_database_gives_header_only(client, login):
+    login()
+    for path, headers in zip(PATHS, [export.BLANK_HEADERS, export.PRINTED_HEADERS]):
+        assert _rows(client.get(path)) == [headers]
+
+
+def _count_queries(client, path, monkeypatch):
+    statements = []
+    real = db_module.connect
+
+    def counting(p):
+        conn = real(p)
+        conn.set_trace_callback(statements.append)
+        return conn
+
+    monkeypatch.setattr(db_module, "connect", counting)
+    assert client.get(path).status_code == 200
+    monkeypatch.setattr(db_module, "connect", real)
+    return len(statements)
+
+
+@pytest.mark.parametrize("path", PATHS)
+def test_query_count_does_not_grow_with_rows(client, login, monkeypatch, path):
+    login()
+
+    def seed(start, n):
+        for i in range(start, start + n):
+            with transaction() as db:
+                item_id = db.execute(
+                    "INSERT INTO item (category_id, brand, item_no, name) VALUES (1, ?, ?, 'T')",
+                    (f"B{i}", f"N{i}")).lastrowid
+                v = stock.get_or_create_variant(repo.get_item(item_id), "黒", "M")
+                stock.receive(_admin(), v, 10)
+                stock.convert_to_printed(_admin(), v, f"D{i}", 5, 5)
+
+    seed(0, 3)
+    small = _count_queries(client, path, monkeypatch)
+    seed(3, 12)
+    assert _count_queries(client, path, monkeypatch) == small
