diff --git a/inventory_app/app/services/export.py b/inventory_app/app/services/export.py
new file mode 100644
index 0000000..ca55010
--- /dev/null
+++ b/inventory_app/app/services/export.py
@@ -0,0 +1,49 @@
+"""CSV出力(Excelで開いてレポートにする用途)。
+
+- 文字コードは UTF-8 の BOM 付き(Excel で日本語が文字化けしない)。改行は CRLF。
+- 在庫 0 の行も出す(「無い」ことも報告したいため)。
+- Excel の数式として実行されないよう、= + - @ などで始まる文字列には ' を付ける(CSVインジェクション対策)。
+"""
+import csv
+import io
+
+from .. import repo
+from ..utils import size_key
+
+BOM = "\ufeff"
+_FORMULA_HEAD = ("=", "+", "-", "@", "\t", "\r")
+
+BLANK_HEADERS = ["カテゴリー", "ブランド", "品番", "商品名", "色", "サイズ", "種類名", "数量", "品番の状態"]
+PRINTED_HEADERS = ["デザイン", "カテゴリー", "ブランド", "品番", "商品名", "色", "サイズ", "種類名", "数量"]
+
+
+def safe_cell(value):
+    """文字列だけを無害化する。数量などの整数はそのまま(Excelで数値として扱える)。"""
+    if isinstance(value, str) and value.startswith(_FORMULA_HEAD):
+        return "'" + value
+    return value
+
+
+def to_csv_bytes(headers, rows) -> bytes:
+    buf = io.StringIO(newline="")
+    w = csv.writer(buf)  # 既定の改行は CRLF
+    w.writerow(headers)
+    for r in rows:
+        w.writerow([safe_cell(c) for c in r])
+    return (BOM + buf.getvalue()).encode("utf-8")
+
+
+def blank_rows(category_id=None):
+    vs = [v for v in repo.all_variants() if category_id is None or v["category_id"] == category_id]
+    vs.sort(key=lambda v: (v["category_order"], v["brand"], v["item_no"], v["item_id"],
+                           v["variant_name"], v["color"], size_key(v["size"])))
+    return [[v["category_name"], v["brand"], v["item_no"], v["item_name"], v["color"], v["size"],
+             v["variant_name"], v["quantity"], "使用中" if v["item_active"] else "停止中"] for v in vs]
+
+
+def printed_rows():
+    ps = repo.products()
+    ps.sort(key=lambda p: (p["design_name"], p["category_order"], p["brand"], p["item_no"],
+                           p["item_id"], p["variant_name"], p["color"], size_key(p["size"])))
+    return [[p["design_name"], p["category_name"], p["brand"], p["item_no"], p["item_name"],
+             p["color"], p["size"], p["variant_name"], p["quantity"]] for p in ps]
